class_name CardData
extends RefCounted
## Static definition of a card, loaded from data/cards/*.json.

const KEYWORDS := ["flippable"]
const EFFECT_TYPES := ["echo", "draw"]

var id := ""
var name := ""
var cost := 1
## Empty for non-wave cards (pure effects such as draw).
var wave := PackedInt32Array()
var keywords := PackedStringArray()
## Each: {"type": "echo", "offset": int} | {"type": "draw", "amount": int}
var effects: Array[Dictionary] = []
## Optional flavor/override text; rules text is generated by rules_text().
var description := ""


static func from_dict(d: Dictionary, errors: PackedStringArray) -> CardData:
	var c := CardData.new()
	c.id = str(d.get("id", ""))
	c.name = str(d.get("name", c.id))
	c.cost = int(d.get("cost", 1))
	c.description = str(d.get("description", ""))
	for v in d.get("wave", []):
		c.wave.append(int(v))
	for k in d.get("keywords", []):
		if not k in KEYWORDS:
			errors.append("card %s: unknown keyword '%s'" % [c.id, k])
		c.keywords.append(str(k))
	for e in d.get("effects", []):
		if not e is Dictionary or not e.get("type", "") in EFFECT_TYPES:
			errors.append("card %s: unknown effect %s" % [c.id, str(e)])
			continue
		var eff := {"type": str(e["type"])}
		for key in e:
			if key != "type":
				eff[key] = int(e[key])
		c.effects.append(eff)
	if c.id == "":
		errors.append("card without id")
	if c.cost < 0:
		errors.append("card %s: negative cost" % c.id)
	if c.wave.is_empty() and c.effects.is_empty():
		errors.append("card %s: no wave and no effects" % c.id)
	return c


func has_keyword(k: String) -> bool:
	return k in keywords


func is_wave_card() -> bool:
	return not wave.is_empty()


func effect_value(type: String, key: String, default := 0) -> int:
	for e in effects:
		if e["type"] == type:
			return e.get(key, default)
	return default


func has_effect(type: String) -> bool:
	for e in effects:
		if e["type"] == type:
			return true
	return false


## Human-readable rules text generated from keywords and effects.
func rules_text() -> String:
	var lines := PackedStringArray()
	if has_keyword("flippable"):
		lines.append("可反相（右键/R）")
	if has_effect("echo"):
		lines.append("回声：%d 格后再放一份" % effect_value("echo", "offset"))
	if has_effect("draw"):
		lines.append("抽 %d 张牌" % effect_value("draw", "amount"))
	if description != "":
		lines.append(description)
	return "\n".join(lines)
